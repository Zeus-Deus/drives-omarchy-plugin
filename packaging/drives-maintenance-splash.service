[Unit]
Description=End initramfs boot screen before Drives maintenance inspection
DefaultDependencies=no
ConditionPathExists=/drives-maintenance-request.json
ConditionPathExists=/run/drives-maintenance/boot.json
ConditionFileIsExecutable=/usr/bin/plymouth
Requires=systemd-remount-fs.service
After=systemd-remount-fs.service
Before=drives-maintenance.target

[Service]
Type=oneshot
RemainAfterExit=yes
# A boot screen that already exited (or never started) is not a failure, and a
# hung one must not fail the whole maintenance target: every step is bounded
# well inside TimeoutStartSec, and a boot screen that ignores quit is ended.
# The audit separately refuses any residual plymouthd process.
ExecStart=-/usr/bin/timeout 5 /usr/bin/plymouth quit
ExecStart=-/usr/bin/timeout 5 /usr/bin/plymouth --wait
ExecStart=-/usr/bin/pkill --exact plymouthd
TimeoutStartSec=20
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
