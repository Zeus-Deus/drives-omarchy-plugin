<?xml version="1.0" encoding="UTF-8"?>
<policyconfig>
<action id="io.github.zeus-deus.drives.provision"><description>Drives: provision</description><message>Administrator authorization is required for this storage operation.</message><defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults></action>
<action id="io.github.zeus-deus.drives.move"><description>Drives: move</description><message>Administrator authorization is required for this storage operation.</message><defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults></action>
<action id="io.github.zeus-deus.drives.resume"><description>Drives: resume</description><message>Administrator authorization is required for this storage operation.</message><defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults></action>
<action id="io.github.zeus-deus.drives.rollback"><description>Drives: rollback</description><message>Administrator authorization is required for this storage operation.</message><defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults></action>
<action id="io.github.zeus-deus.drives.delete"><description>Drives: delete</description><message>Administrator authorization is required for this storage operation.</message><defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults></action>
<action id="io.github.zeus-deus.drives.cancel"><description>Drives: cancel</description><message>Administrator authorization is required for this storage operation.</message><defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults></action>
<action id="io.github.zeus-deus.drives.restart"><description>Drives: restart</description><message>Administrator authorization is required for this storage operation.</message><defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults></action>
<action id="io.github.zeus-deus.drives.export"><description>Drives: export</description><message>Administrator authorization is required for this storage operation.</message><defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults></action>
</policyconfig>
