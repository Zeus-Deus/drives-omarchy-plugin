# Drives-owned: io.github.zeus-deus.drives; content recorded in .ownership.json
[Unit]
Description=Drives inspect-only maintenance boot
DefaultDependencies=no
Requires=systemd-remount-fs.service systemd-journald.service systemd-udevd.service drives-maintenance-splash.service
After=systemd-remount-fs.service systemd-journald.service systemd-udevd.service drives-maintenance-splash.service
Wants=drives-maintenance-worker.service
Conflicts=shutdown.target
Before=shutdown.target
